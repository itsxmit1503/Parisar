CLOUDINARY_API_SECRET=your_api_secret

# Public API & App URLs
NEXT_PUBLIC_API_URL=https://parisar-api.onrender.com/api/v1
NEXT_PUBLIC_APP_URL=https://parisar-dhsgsu.vercel.app

# Authentication Secret
JWT_SECRET=super_secret_jwt_key_dhsgsu_parisar
