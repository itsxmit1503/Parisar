# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/parisar_dhsgsu?retryWrites=true&w=majority

# Cloudinary Media Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
