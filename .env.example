# Environment Configuration Template (Do NOT commit real secret keys)
# ==============================================================================

# MongoDB Connection URI (Optional in local dev - falls back to shared in-memory store if omitted)
MONGODB_URI=

# JWT Signing Secret (Minimum 32 characters recommended in production)
JWT_SECRET=

# Initial Super Administrator Bootstrap Credentials
# Used idempotently on server startup to ensure at least one active SUPER_ADMIN exists
SUPER_ADMIN_EMAIL=dsw@dhsgsu.edu.in
SUPER_ADMIN_PASSWORD=

# Web: Google Maps JavaScript API Key (Optional - falls back to live Google Maps Geographic Embed if omitted)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Android: Google Maps SDK API Key (Injected via Gradle manifestPlaceholders in android/app/build.gradle)
MAPS_API_KEY=
